            "summarizeBy": "none"
          }
        ],
        "lineageTag": "2104060e-4c83-4333-afd8-a3ac5bfcce3d",
        "measures": [
          {
            "name": "Orders",
            "description": "One row per source order; all statuses retained.",
            "expression": "COUNTROWS(Orders)",
            "formatString": "#,0",
            "lineageTag": "4917c981-a739-461b-8e15-4cad7b4ac950"
          },
          {
            "name": "Delivered Orders",
            "description": "Source status Delivered, including those missing timing.",
            "expression": "CALCULATE([Orders], Orders[Status] = \"Delivered\")",
            "formatString": "#,0",
            "lineageTag": "9b84f083-b82d-4871-8a09-2449c37c65e4"
          },
          {
            "name": "Delivered Merchandise BRL",
            "description": "Delivered order item prices, excludes freight. Not profit or recognized revenue.",
            "expression": "DIVIDE(CALCULATE(SUM(Orders[Merchandise Cents]), Orders[Status] = \"Delivered\"), 100)",
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "ce6d3408-ef2c-4162-95a9-6b66066e73bc"
          },
          {
            "name": "Eligible Deliveries",
            "description": "Delivered status and valid actual/estimated timing; delivery not before purchase.",
            "expression": "SUM(Orders[Delivery Eligible])",
            "formatString": "#,0",
            "lineageTag": "83f856dd-a90a-4cc1-81a2-0482c662cd6f"
          },
          {
            "name": "Late Deliveries",
            "description": "Eligible deliveries whose actual calendar date exceeds estimated calendar date.",
            "expression": "SUM(Orders[Late])",
            "formatString": "#,0",
            "lineageTag": "7f18bfeb-72c3-42a6-a500-002f96e26f7c"
          },
          {
            "name": "On Time Rate",
            "description": "Eligible denominator; blank where none are eligible.",
            "expression": "DIVIDE([Eligible Deliveries] - [Late Deliveries], [Eligible Deliveries])",
            "formatString": "0.0%",
            "lineageTag": "92bc677e-986e-4ed6-8cd0-c50b54a66f27"
          },
          {
            "name": "Late Rate Trend",
            "description": "Monthly trend suppressed where fewer than 100 eligible deliveries; totals elsewhere remain unchanged.",
            "expression": "IF([Eligible Deliveries] >= 100, [Late Rate])",
            "formatString": "0.0%",
            "lineageTag": "bc56f8a9-3bb4-4fac-b43a-a7a8c88863ee"
          },
          {
            "name": "Late Rate",
            "description": "Late eligible deliveries divided by eligible deliveries.",
            "expression": "DIVIDE([Late Deliveries], [Eligible Deliveries])",
            "formatString": "0.0%",
            "lineageTag": "4a224426-9307-44ba-b4ba-661a03f6793e"
          },
          {
            "name": "Median Delivery Days",
            "description": "Median calendar days purchase to delivery for eligible orders.",
            "expression": "CALCULATE(MEDIAN(Orders[Delivery Days]), Orders[Delivery Eligible] = 1)",
            "formatString": "0.0\" days\"",
            "lineageTag": "09f37348-d4f9-481b-967c-c7de987cffcd"
          },
          {
            "name": "Average Late Days",
            "description": "Mean lateness among late orders only.",
            "expression": "CALCULATE(AVERAGE(Orders[Late Days]), Orders[Late] = 1)",
            "formatString": "0.0\" days\"",
            "lineageTag": "2e3b8c9c-d7f1-4e6f-92be-1841624f73fd"
          },
          {
            "name": "Timing Exclusions",
            "description": "Delivered orders excluded from timing calculations.",
            "expression": "[Delivered Orders] - [Eligible Deliveries]",
            "formatString": "#,0",
            "lineageTag": "d5dd8555-becc-4e7e-b39a-39d76652a858"
          },
          {
            "name": "Review Late Rate",
            "description": "Rate shown only for selections with at least 100 eligible deliveries; this is a readability guard, not a confidence interval.",
            "expression": "IF([Eligible Deliveries] >= 100, [Late Rate])",
            "formatString": "0.0%",
            "lineageTag": "17cabd83-dfeb-4dba-8de3-7bea274a6f8b"
          },
          {
            "name": "Eligible Share",
            "expression": "DIVIDE([Eligible Deliveries], CALCULATE([Eligible Deliveries], REMOVEFILTERS(States)))",
            "formatString": "0.0%",
            "lineageTag": "d6b54b02-a79e-4abf-b072-adc832a4d5a1"
          },
          {
            "name": "Selection Note",
            "expression": "\"Eligible deliveries: \" & FORMAT([Eligible Deliveries], \"#,0\") & \". Late means actual calendar delivery date after estimated date. Rates are blank where N < 100.\"",
            "lineageTag": "6a55f583-4af0-44df-8aa0-2978981f76a7"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Pointer = Json.Document(File.Contents(DataRoot & \"/latest.json\")),",
                "    Contract = if Pointer[contract_version] = 1 then Pointer[snapshot] else error \"Unsupported data contract\",",
                "    Source = Csv.Document(File.Contents(DataRoot & \"/snapshots/\" & Contract & \"/Orders.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Order ID\", type text}, {\"Purchase Date\", type date}, {\"State\", type text}, {\"Status\", type text}, {\"Delivered Date\", type date}, {\"Estimated Date\", type date}, {\"Item Count\", Int64.Type}, {\"Merchandise Cents\", Int64.Type}, {\"Freight Cents\", Int64.Type}, {\"Payment Cents\", Int64.Type}, {\"Payment Difference Cents\", Int64.Type}, {\"Delivery Eligible\", Int64.Type}, {\"Late\", Int64.Type}, {\"Delivery Days\", Int64.Type}, {\"Late Days\", Int64.Type}, {\"Delivery Band\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
