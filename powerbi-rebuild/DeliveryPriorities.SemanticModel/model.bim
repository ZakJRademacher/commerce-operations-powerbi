            "summarizeBy": "none"
          }
        ],
        "lineageTag": "a6e46d35-20d8-422c-8910-292724827963",
        "measures": [
          {
            "name": "Item Lines",
            "description": "One row per source item; each row represents one ordered unit.",
            "expression": "COUNTROWS(Items)",
            "formatString": "#,0",
            "lineageTag": "79f469cf-fb0f-4116-8ce1-044bcf4bae26"
          },
          {
            "name": "Delivered Item Lines",
            "description": "Source item rows whose order status is delivered.",
            "expression": "CALCULATE([Item Lines], Items[Status] = \"Delivered\")",
            "formatString": "#,0",
            "lineageTag": "c5231314-6256-4a29-9592-8dd055501c7f"
          },
          {
            "name": "Category Merchandise BRL",
            "description": "Delivered item prices; responds to category filters.",
            "expression": "DIVIDE(CALCULATE(SUM(Items[Price Cents]), Items[Status] = \"Delivered\"), 100)",
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "283ad534-cd40-47c5-a090-49dcc9c29f71"
          },
          {
            "name": "Delivered Freight BRL",
            "description": "Source item-level freight charges for delivered orders.",
            "expression": "DIVIDE(CALCULATE(SUM(Items[Freight Cents]), Items[Status] = \"Delivered\"), 100)",
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "eb061169-fda2-431b-96ce-592be690db24"
          },
          {
            "name": "Freight to Merchandise",
            "description": "Freight divided by merchandise; not margin and not share of gross checkout.",
            "expression": "DIVIDE([Delivered Freight BRL], [Category Merchandise BRL])",
            "formatString": "0.0%",
            "lineageTag": "5af6d5a2-052a-40e1-b30e-567eb8c47a80"
          },
          {
            "name": "Uncategorized Lines",
            "description": "Item rows with missing source product category.",
            "expression": "CALCULATE([Item Lines], Items[Category Mapping] = \"Missing source category\")",
            "formatString": "#,0",
            "lineageTag": "0d4f2543-7d91-4d47-977f-87ed72d7322b"
          }
        ],
