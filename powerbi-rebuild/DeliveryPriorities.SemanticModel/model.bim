        "measures": [
          {
            "name": "Flagged Rows",
            "description": "Row count for the selected quality check; grains can differ and overlap.",
            "expression": "IF(ISINSCOPE(Quality[Check]), SUM(Quality[Rows]))",
            "formatString": "#,0",
            "lineageTag": "5a0eb2a1-7e7c-4724-9c57-206978061450"
          }
