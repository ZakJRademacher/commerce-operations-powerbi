","description":"Item rows with missing source product category."}],"partitions":[{"name":"Items","mode":"import","source":{"type":"m","expression":["let","    Pointer = Json.Document(File.Contents(DataRoot & \"/latest.json\")),","    Contract = if Pointer[contract_version] = 1 then Pointer[snapshot] else error \"Unsupported data contract\",","    Source = Csv.Document(File.Contents(DataRoot & \"/snapshots/\" & Contract & \"/Items.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),","    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),","    Typed = Table.TransformColumnTypes(Headers, {{\"Order ID\", type text}, {\"Item Number\", Int64.Type}, {\"Product ID\", type text}, {\"Purchase Date\", type date}, {\"State\", type text}, {\"Status\", type text}, {\"Category\", type text}, {\"Category Mapping\", type text}, {\"Price Cents\", Int64.Type}, {\"Freight Cents\", Int64.Type}, {\"Category Group\", type text}}, \"en-US\")","in","    Typed"]}}]},{"name":"Dates","columns":[{"name":"Date","dataType":"dateTime","sourceColumn":"Date","summarizeBy":"none","formatString":"yyyy-MM-dd","annotations":[{"name":"UnderlyingDateTimeDataType","value":"Date"}]},{"name":"Month","dataType":"string","sourceColumn":"Month","summarizeBy":"none"},{"name":"Year","dataType":"int64","sourceColumn":"Year","summarizeBy":"none"}],"measures":[],"partitions":[{"name":"Dates","mode":"import","source":{"type":"m","expression":["let","    Pointer = Json.Document(File.Contents(DataRoot & \"/latest.json\")),","    Contract = if Pointer[contract_version] = 1 then Pointer[snapshot] else error \"Unsupported data contract\",","    Source = Csv.Document(File.Contents(DataRoot & \"/snapshots/\" & Contract & \"/Dates.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),","    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),","    Typed = Table.TransformColumnTypes(Headers, {{\"Date\", type date}, {\"Month\", type text}, {\"Year\", Int64.Type}