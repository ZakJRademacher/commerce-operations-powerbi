{"name":"Commerce","compatibilityLevel":1600,"model":{"culture":"en-US","defaultPowerBIDataSourceVersion":"powerBI_V3","expressions":[{"name":"DataRoot","kind":"m","expression":"\"C:/Users/zakjr/Documents/Codex/2026-10-14/i-x20/outputs/commerce-operations-powerbi/data/processed\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"}],"tables":[{"name":"Orders","columns":[{"name":"Order ID","dataType":"string","sourceColumn":"Order ID","summarizeBy":"none"},{"name":"Purchase Date","dataType":"dateTime","sourceColumn":"Purchase Date","summarizeBy":"none","formatString":"yyyy-MM-dd","annotations":[{"name":"UnderlyingDateTimeDataType","value":"Date"}]},{"name":"State","dataType":"string","sourceColumn":"State","summarizeBy":"none"},{"name":"Status","dataType":"string","sourceColumn":"Status","summarizeBy":"none"},{"name":"Delivered Date","dataType":"dateTime","sourceColumn":"Delivered Date","summarizeBy":"none","formatString":"yyyy-MM-dd","annotations":[{"name":"UnderlyingDateTimeDataType","value":"Date"}]},{"name":"Estimated Date","dataType":"dateTime","sourceColumn":"Estimated Date","summarizeBy":"none","formatString":"yyyy-MM-dd","annotations":[{"name":"UnderlyingDateTimeDataType","value":"Date"}]},{"name":"Item Count","dataType":"int64","sourceColumn":"Item Count","summarizeBy":"none","isHidden":true},{"name":"Merchandise Cents","dataType":"int64","sourceColumn":"Merchandise Cents","summarizeBy":"none","isHidden":true},{"name":"Freight Cents","dataType":"int64","sourceColumn":"Freight Cents","summarizeBy":"none","isHidden":true},{"name":"Payment Cents","dataType":"int64","sourceColumn":"Payment Cents","summarizeBy":"none","isHidden":true},{"name":"Payment Difference Cents","dataType":"int64","sourceColumn":"Payment Difference Cents","summarizeBy":"none","isHidden":true},{"name":"Delivery Eligible","dataType":"int64","sourceColumn":"Delivery Eligible","summarizeBy":"none","isHidden":true},{"name":"Late","dataType":"int64","sourceColumn":"Late","summarizeBy":"none","isHidden":true},{"name":"Delivery Days","dataType":"int64","sourceColumn":"Delivery Days","summarizeBy":"none","isHidden":true},{"name":"Late Days","dataType":"int64","sourceColumn":"Late Days","summarizeBy":"none","isHidden":true},{"name":"Delivery Band","dataType":"string","sourceColumn":"Delivery Band","summarizeBy":"none"}],"measures":[{"name":"Orders","expression":"COUNTROWS(Orders)","formatString":"#,0","description":"One row per source order; all statuses retained."},{"name":"Delivered Orders","expression":"CALCULATE([Orders], Orders[Status] = \"Delivered\")","formatString":"#,0","description":"Source status Delivered, including those missing timing."},{"name":"Delivered Merchandise BRL","expression":"DIVIDE(CALCULATE(SUM(Orders[Merchandise Cents]), Orders[Status] = \"Delivered\"), 100)","formatString":"\"R$ \"#,0.00","description":"Delivered order item prices, excludes freight. Not profit or recognized revenue."},{"name":"Eligible Deliveries","expression":"SUM(Orders[Delivery Eligible])","formatString":"#,0","description":"Delivered status and valid actual/estimated timing; delivery not before purchase."},{"name":"Late Deliveries","expression":"SUM(Orders[Late])","formatString":"#,0","description":"Eligible deliveries whose actual calendar date exceeds estimated calendar date."},{"name":"On Time Rate","expression":"DIVIDE([Eligible Deliveries] - [Late Deliveries], [Eligible Deliveries])","formatString":"0.0%","description":"Eligible denominator; blank where none are eligible."},{"name":"Late Rate Trend","expression":"IF([Eligible Deliveries] >= 100, [Late Rate])","formatString":"0.0%","description":"Monthly trend suppressed where fewer than 100 eligible deliveries; totals elsewhere remain unchanged."},{"name":"Late Rate","expression":"DIVIDE([Late Deliveries], [Eligible Deliveries])","formatString":"0.0%","description":"Late eligible deliveries divided by eligible deliveries."},{"name":"Median Delivery Days","expression":"CALCULATE(MEDIAN(Orders[Delivery Days]), Orders[Delivery Eligible] = 1)","formatString":"0.0\" days\"","description":"Median calendar days purchase to delivery for eligible orders."},{"name":"Average Late Days","expression":"CALCULATE(AVERAGE(Orders[Late Days]), Orders[Late] = 1)","formatString":"0.0\" days\"","description":"Mean lateness among late orders only."},{"name":"Timing Exclusions","expression":"[Delivered Orders] - [Eligible Deliveries]","formatString":"#,0","description":"Delivered orders excluded from timing calculations."}],"partitions":[{"name":"Orders","mode":"import","source":{"type":"m","expression":["let","    Pointer = Json.Document(File.Contents(DataRoot & \"/latest.json\")),","    Contract = if Pointer[contract_version] = 1 then Pointer[snapshot] else error \"Unsupported data contract\",","    Source = Csv.Document(File.Contents(DataRoot & \"/snapshots/\" & Contract & \"/Orders.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),","    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),","    Typed = Table.TransformColumnTypes(Headers, {{\"Order ID\", type text}, {\"Purchase Date\", type date}, {\"State\", type text}, {\"Status\", type text}, {\"Delivered Date\", type date}, {\"Estimated Date\", type date}, {\"Item Count\", Int64.Type}, {\"Merchandise Cents\", Int64.Type}, {\"Freight Cents\", Int64.Type}, {\"Payment Cents\", Int64.Type}, {\"Payment Difference Cents\", Int64.Type}, {\"Delivery Eligible\", Int64.Type}, {\"Late\", Int64.Type}, {\"Delivery Days\", Int64.Type}, {\"Late Days\", Int64.Type}, {\"Delivery Band\", type text}}, \"en-US\")","in","    Typed"]}}]},{"name":"Items","columns":[{"name":"Order ID","dataType":"string","sourceColumn":"Order ID","summarizeBy":"none"},{"name":"Item Number","dataType":"int64","sourceColumn":"Item Number","summarizeBy":"none","isHidden":true},{"name":"Product ID","dataType":"string","sourceColumn":"Product ID","summarizeBy":"none"},{"name":"Purchase Date","dataType":"dateTime","source